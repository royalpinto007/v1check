{
  "name": "v1check",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Offline Solana Transaction V1 compatibility checks with file references and shareable reports.",
  "author": "Royal Pinto <royalpinto007@gmail.com>",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "demo": "npm run build && node dist/cli.js --demo --fail-on never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "package:check": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "ignore": "^7.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "@types/semver": "^7.7.1"
  },
  "bin": {
    "v1check": "dist/cli.js"
  },
  "files": [
    "dist/",
    "fixtures/demo/",
    "docs/*.md",
    "docs/*.svg",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalpinto007/v1check.git"
  },
  "homepage": "https://www.npmjs.com/package/v1check",
  "bugs": {
    "url": "https://github.com/royalpinto007/v1check/issues"
  },
  "keywords": [
    "solana",
    "transaction-v1",
    "compatibility",
    "static-analysis",
    "cli",
    "offline",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
